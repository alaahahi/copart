# APP_NAME is framework-only (mail from-name, cache/session prefixes).
APP_NAME=Laravel
# Commercial brand shown in the navbar, page titles and printed reports.
APP_PRODUCT_NAME=HAULF
# Secondary line under the brand name in the navbar.
APP_PRODUCT_TAGLINE="Shipping ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Leave empty to auto-detect. Set "" when /img/... works, or /public when /public/img/... works.
# APP_PUBLIC_WEB_PREFIX=

# Dedicated password for Settings system wipe (تصفير النظام).
# Set a strong secret on each server. Leave empty to disable wipe until configured.
# Never commit the real password. Frontend must NOT embed this value.
SYSTEM_RESET_PASSWORD=

# ---------------------------------------------------------------------------
# Session / login lifetime (Inertia web ERP)
# 43200 minutes = 30 days. Cookie does not expire on browser close.
# Production HTTPS: set SESSION_SECURE_COOKIE=true
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=
# same_site is configured as "lax" in config/session.php (CSRF-safe default)

# Remember-me cookie lifetime (minutes). Matches session (~30 days).
AUTH_REMEMBER_MINUTES=43200

# Sanctum token pair (API / Bearer). Access ~1 day; refresh ~30 days.
# Refresh endpoint: POST /api/auth/refresh  { "refresh_token": "..." }
SANCTUM_ACCESS_TOKEN_TTL_MINUTES=1440
SANCTUM_REFRESH_TOKEN_TTL_MINUTES=43200
